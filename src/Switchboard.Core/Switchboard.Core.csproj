<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Switchboard is a lightweight application proxy combining reverse proxy and API gateway functionality.</Title>
		<Version>5.0.0</Version>
		<Description>Switchboard is a lightweight application proxy combining reverse proxy and API gateway functionality.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageReleaseNotes>v5.0.0: Intelligent routing and load balancing — least-connections, power-of-two-choices, weighted, and latency-aware modes; passive health checks with outlier ejection; automatic retries/failover; sticky sessions; slow start; and per-endpoint weighted canary with header routing. Observability via OpenTelemetry — metrics and traces exported over OTLP, with a turnkey Prometheus/Tempo/Loki/Grafana Docker stack</PackageReleaseNotes>

		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>Switchboard.Core.xml</DocumentationFile>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<PackageId>SwitchboardApplicationProxy</PackageId>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Product>Switchboard</Product>
		<PackageProjectUrl>https://github.com/jchristn/switchboard</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/switchboard</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageTags>reverse proxy application proxy api gateway rest</PackageTags>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Test.Shared" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
		<PackageReference Include="MySqlConnector" Version="2.4.0" />
		<PackageReference Include="Npgsql" Version="9.0.2" />
		<PackageReference Include="OpenTelemetry" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
		<PackageReference Include="RestWrapper" Version="3.1.8" />
		<PackageReference Include="SerializationHelper" Version="2.0.3" />
		<PackageReference Include="SyslogLogging" Version="2.0.12" />
		<PackageReference Include="Watson" Version="7.0.14" />
	</ItemGroup>

</Project>
