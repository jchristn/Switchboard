<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Title>Switchboard is a lightweight application proxy combining reverse proxy and API gateway functionality.</Title>
		<Version>5.1.0</Version>
		<Description>Switchboard is a lightweight application proxy combining reverse proxy and API gateway functionality.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageReleaseNotes>v5.1.0: Dependency refresh across the stack (Npgsql 10, Microsoft.Data.Sqlite 10, Microsoft.Data.SqlClient 7, MySqlConnector 2.6, Watson 7.1, RestWrapper 3.2, SyslogLogging 2.2). Fixes forwarding of the client Authorization header to origin servers: RestWrapper 3.2 applies Authorization via a typed property and ignores it in the raw header collection, so the gateway now forwards it through Authorization.Raw, preserving any scheme (Bearer, Basic, or custom).</PackageReleaseNotes>

		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>Switchboard.Core.xml</DocumentationFile>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<PackageId>SwitchboardApplicationProxy</PackageId>
		<Authors>Joel Christner</Authors>
		<Company>Joel Christner</Company>
		<Product>Switchboard</Product>
		<PackageProjectUrl>https://github.com/jchristn/switchboard</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/switchboard</RepositoryUrl>
		<RepositoryType>github</RepositoryType>
		<PackageTags>reverse proxy application proxy api gateway rest</PackageTags>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Test.Shared" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
		<PackageReference Include="MySqlConnector" Version="2.6.2" />
		<PackageReference Include="Npgsql" Version="10.0.3" />
		<PackageReference Include="OpenTelemetry" Version="1.17.0" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
		<PackageReference Include="RestWrapper" Version="3.2.0" />
		<PackageReference Include="SerializationHelper" Version="2.0.3" />
		<PackageReference Include="SyslogLogging" Version="2.2.1" />
		<PackageReference Include="Watson" Version="7.1.0" />
	</ItemGroup>

</Project>
