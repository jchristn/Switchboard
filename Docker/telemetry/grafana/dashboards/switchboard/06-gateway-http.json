{
  "uid": "sb-gateway",
  "title": "Switchboard / Gateway & HTTP",
  "description": "Requests the gateway rejects itself, and the HTTP server layer (connections, throughput, management API) measured by Watson.",
  "tags": [
    "switchboard",
    "gateway"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Switchboard",
      "type": "dashboards",
      "tags": [
        "switchboard"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(switchboard_build_info, service_instance_id)",
          "refId": "q"
        },
        "definition": "label_values(switchboard_build_info, service_instance_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "description": "Switchboard process (service.instance.id). Each restart gets a new id."
      }
    ]
  },
  "annotations": {
    "list": []
  },
