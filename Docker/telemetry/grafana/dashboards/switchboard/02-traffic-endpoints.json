{
  "uid": "sb-traffic",
  "title": "Switchboard / Traffic & Endpoints",
  "description": "Request rate, errors, and latency per API endpoint: find the endpoint that is slow or failing.",
  "tags": [
    "switchboard",
    "traffic"
  ],
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "links": [
    {
      "title": "Switchboard",
      "type": "dashboards",
      "tags": [
        "switchboard"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(switchboard_build_info, service_instance_id)",
          "refId": "q"
        },
        "definition": "label_values(switchboard_build_info, service_instance_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1,
        "description": "Switchboard process (service.instance.id). Each restart gets a new id."
      },
      {
        "name": "endpoint",
        "label": "Endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(switchboard_requests_total{service_instance_id=~\"$instance\"}, endpoint)",
          "refId": "q"
        },
        "definition": "label_values(switchboard_requests_total{service_instance_id=~\"$instance\"}, endpoint)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "description": "",
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "topn",
        "label": "Top N",
        "type": "custom",
        "query": "5,10,20,50",
        "current": {
          "selected": true,
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "selected": false,
            "text": "5",
            "value": "5"
