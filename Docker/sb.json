{
  "Logging": {
    "Servers": [
      {
        "Hostname": "127.0.0.1",
        "Port": 514,
        "RandomizePorts": false,
        "MinimumPort": 65000,
        "MaximumPort": 65535
      }
    ],
    "LogDirectory": "./logs/",
    "LogFilename": "./logs/switchboard.log",
    "ConsoleLogging": true,
    "EnableColors": true,
    "MinimumSeverity": 1
  },
  "Endpoints": [
    {
      "Identifier": "google",
      "Name": "google",
      "TimeoutMs": 60000,
      "LoadBalancing": "RoundRobin",
      "IncludeAuthContextHeader": false,
      "BlockHttp10": false,
      "LogRequestFull": false,
      "LogRequestBody": false,
      "LogResponseBody": false,
      "MaxRequestBodySize": 536870912,
      "OriginServers": [
        "google"
      ],
      "UseGlobalBlockedHeaders": true,
      "AuthContextHeader": "x-sb-auth-context",
      "BlockedHeaders": [],
      "Unauthenticated": {
        "ParameterizedUrls": {
          "GET": [
            "/foo"
          ]
        }
      },
      "Authenticated": {
        "ParameterizedUrls": {}
      },
      "RewriteUrls": {
        "": {
          "/foo": "/"
        }
      },
      "OpenApiDocumentation": {
        "Routes": {}
      },
      "CaptureRequestBody": false,
      "CaptureResponseBody": false,
      "CaptureRequestHeaders": true,
      "CaptureResponseHeaders": true,
      "MaxCaptureRequestBodySize": 65536,
      "MaxCaptureResponseBodySize": 65536
    }
  ],
  "Origins": [
    {
      "Identifier": "google",
      "Name": "google",
      "Hostname": "google.com",
      "Port": 443,
      "Ssl": true,
      "HealthCheckIntervalMs": 5000,
      "UnhealthyThreshold": 2,
      "HealthyThreshold": 1,
      "HealthCheckMethod": "HEAD",
      "HealthCheckUrl": "/",
      "MaxParallelRequests": 10,
      "RateLimitRequestsThreshold": 30,
      "LogRequestBody": false,
      "LogResponseBody": false,
      "CaptureRequestBody": false,
      "CaptureResponseBody": false,
      "CaptureRequestHeaders": true,
      "CaptureResponseHeaders": true,
      "MaxCaptureRequestBodySize": 65536,
      "MaxCaptureResponseBodySize": 65536
    }
  ],
  "BlockedHeaders": [
    "alt-svc",
    "connection",
    "date",
    "host",
    "keep-alive",
    "proxy-authorization",
    "proxy-connection",
    "set-cookie",
    "transfer-encoding",
    "upgrade",
    "via",
    "x-forwarded-for",
    "x-request-id"
  ],
  "Webserver": {
    "Hostname": "*",
    "Port": 8000,
    "Prefix": "http://*:8000/",
    "Protocols": {
      "EnableHttp1": true,
      "EnableHttp2": false,
      "EnableHttp3": false,
      "EnableHttp2Cleartext": false,
      "MaxConcurrentStreams": 100,
      "Http2": {
        "HeaderTableSize": 4096,
        "EnablePush": false,
        "MaxConcurrentStreams": 100,
        "InitialWindowSize": 65535,
        "MaxFrameSize": 16384,
        "MaxHeaderListSize": 65536
      },
      "Http3": {
        "MaxFieldSectionSize": 0,
        "QpackMaxTableCapacity": 0,
        "QpackBlockedStreams": 0,
        "EnableDatagram": false
      },
      "IdleTimeoutMs": 120000
    },
    "AltSvc": {
      "Enabled": false,
      "Port": 0,
      "Http3Alpn": "h3",
      "MaxAgeSeconds": 86400
    },
    "IO": {
      "Http1": {
        "PoolMaxRetainedPerType": 256,
        "ResponseHeaderTemplateCacheSize": 256,
        "StatusLineCacheSize": 64
      },
      "StreamBufferSize": 65536,
      "MaxRequests": 1024,
      "ReadTimeoutMs": 10000,
      "MaxIncomingHeadersSize": 65536,
      "EnableKeepAlive": false,
      "MaxRequestBodySize": 0,
      "MaxHeaderCount": 64
    },
    "Ssl": {
      "Enable": false,
      "MutuallyAuthenticate": false,
      "AcceptInvalidAcertificates": true
    },
    "Headers": {
      "IncludeContentLength": true,
      "DefaultHeaders": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "OPTIONS, HEAD, GET, PUT, POST, DELETE, PATCH",
        "Access-Control-Allow-Headers": "*",
        "Access-Control-Expose-Headers": "",
        "Accept": "*/*",
        "Accept-Language": "en-US, en",
        "Accept-Charset": "ISO-8859-1, utf-8",
        "Cache-Control": "no-cache",
        "Connection": "close",
        "Host": "a563dbb42db6:8000"
      }
    },
    "AccessControl": {
      "DenyList": {},
      "PermitList": {},
      "Mode": "DefaultPermit"
    },
    "Debug": {
      "AccessControl": false,
      "Routing": false,
      "Requests": false,
      "Responses": false
    },
    "Timeout": {
      "DefaultTimeout": "00:00:00"
    },
    "WebSockets": {
      "Enable": false,
      "MaxMessageSize": 16777216,
      "ReceiveBufferSize": 65536,
      "CloseHandshakeTimeoutMs": 5000,
      "AllowClientSuppliedGuid": false,
      "ClientGuidHeaderName": "x-guid",
      "SupportedVersions": [
        "13"
      ],
      "EnableHttp1": true,
      "EnableHttp2": false,
      "EnableHttp3": false
    },
    "UseMachineHostname": true
  },
  "OpenApi": {
    "Enable": false,
    "EnableSwaggerUi": true,
    "DocumentPath": "/openapi.json",
    "SwaggerUiPath": "/swagger",
    "Title": "Switchboard API",
    "Version": "4.1.0",
    "Contact": {},
    "License": {},
    "Servers": [],
    "SecuritySchemes": {},
    "Tags": []
  },
  "Database": {
    "Type": "Sqlite",
    "Filename": "./data/switchboard.db",
    "Ssl": false,
    "TrustServerCertificate": false
  },
  "Management": {
    "Enable": true,
    "BasePath": "/_sb/v1.0/",
    "AdminToken": "sbadmin",
    "RequireAuthentication": true
  },
  "RequestHistory": {
    "Enable": true,
    "CaptureRequestBody": false,
    "CaptureResponseBody": false,
    "CaptureRequestHeaders": true,
    "CaptureResponseHeaders": true,
    "MaxRequestBodySize": 65536,
    "MaxResponseBodySize": 65536,
    "RetentionDays": 90,
    "MaxRecords": 100000,
    "CleanupIntervalSeconds": 3600
  }
}